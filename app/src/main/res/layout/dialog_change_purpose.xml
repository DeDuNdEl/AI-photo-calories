<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <CheckBox
        android:id="@+id/purpose_minus_dialog"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/edit_text_border2"
        android:text="Сбросить"
        android:textColor="#000000"
        app:layout_constraintBottom_toTopOf="@+id/accept_dialog"
        app:layout_constraintStart_toStartOf="parent" />

    <CheckBox
        android:id="@+id/purpose_save_dialog"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:background="@drawable/edit_text_border2"
        android:text="Сохранить"
        android:textColor="#000000"
        app:layout_constraintBottom_toTopOf="@+id/accept_dialog"
        app:layout_constraintEnd_toStartOf="@+id/purpose_plus_dialog"
        app:layout_constraintStart_toEndOf="@+id/purpose_minus_dialog" />

    <CheckBox
        android:id="@+id/purpose_plus_dialog"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/edit_text_border2"
        android:text="Набрать"
        android:textColor="#000000"
        app:layout_constraintBottom_toTopOf="@+id/accept_dialog"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/accept_dialog"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginTop="400dp"
        android:background="@drawable/edit_text_border2"
        android:gravity="center"
        android:text="Принять"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>