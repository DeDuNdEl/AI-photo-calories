<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.CounterFragment"
    android:background="#FFE4B5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <TextView
            android:id="@+id/breakfast_counter"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center"
            android:text="Завтрак"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/num_of_day_counter" />

        <ImageView
            android:id="@+id/breakfast_photo_counter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:src="@drawable/custom_camera"
            app:layout_constraintStart_toEndOf="@+id/breakfast_counter"
            app:layout_constraintTop_toBottomOf="@+id/num_of_day_counter" />

        <TextView
            android:id="@+id/lunch_counter"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center"
            android:text="Обед"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/breakfast_counter" />

        <ImageView
            android:id="@+id/lunch_photo_counter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:src="@drawable/custom_camera"
            app:layout_constraintStart_toEndOf="@+id/lunch_counter"
            app:layout_constraintTop_toBottomOf="@+id/breakfast_photo_counter" />

        <TextView
            android:id="@+id/dinner_counter"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center"
            android:text="Ужин"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lunch_counter" />

        <ImageView
            android:id="@+id/dinner_photo_counter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:src="@drawable/custom_camera"
            app:layout_constraintStart_toEndOf="@+id/dinner_counter"
            app:layout_constraintTop_toBottomOf="@+id/lunch_photo_counter" />

        <TextView
            android:id="@+id/other_counter"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center"
            android:text="Перекус/Другое"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dinner_counter" />

        <ImageView
            android:id="@+id/other_photo_counter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:src="@drawable/custom_camera"
            app:layout_constraintStart_toEndOf="@+id/other_counter"
            app:layout_constraintTop_toBottomOf="@+id/dinner_photo_counter" />

        <TextView
            android:id="@+id/num_of_day_counter"
            android:layout_width="180dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_strong"

            android:gravity="center|left"
            android:text=" День N"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:text="Счетчик"
            android:textColor="#000000"
            android:textSize="34sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/profile_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"

            android:src="@drawable/custom_user_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/summ_of_ccall_counter"
            android:layout_width="225dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="100dp"
            android:text="Сумма ккалл за день:"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/other_counter" />

        <TextView
            android:id="@+id/summ_of_ccall_counter_box"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/edit_text_strong2"
            android:gravity="center"
            android:text="Сумма ккалл за день:"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/other_counter"
            app:layout_constraintTop_toBottomOf="@+id/other_counter" />

        <TextView
            android:id="@+id/need_summ_of_ccall_counter"
            android:layout_width="225dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:text="Суточная норма:"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/summ_of_ccall_counter" />

        <TextView
            android:id="@+id/need_summ_of_ccall_counter_box"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_strong2"
            android:gravity="center"
            android:text="0.0"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/other_counter"
            app:layout_constraintTop_toBottomOf="@+id/summ_of_ccall_counter_box" />


        <TextView
            android:id="@+id/summ_of_PFC_counter"
            android:layout_width="225dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:text="БЖУ за день:"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/need_summ_of_ccall_counter" />

        <TextView
            android:id="@+id/summ_of_PFC_counter_box"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_strong2"
            android:gravity="center"
            android:text="Сумма ккалл за день:"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/other_counter"
            app:layout_constraintTop_toBottomOf="@+id/need_summ_of_ccall_counter_box" />

        <TextView
            android:id="@+id/need_summ_of_PFC_counter"
            android:layout_width="225dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:text="Суточная норма БЖУ:"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/summ_of_PFC_counter" />

        <TextView
            android:id="@+id/need_summ_of_PFC_counter_box"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_strong2"
            android:gravity="center"
            android:text="0.0"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/other_counter"
            app:layout_constraintTop_toBottomOf="@+id/summ_of_PFC_counter" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>