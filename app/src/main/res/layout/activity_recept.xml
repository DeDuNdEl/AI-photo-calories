<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activites.ReceptActivity"
    android:background="#FFE4B5">

    <TextView
        android:id="@+id/name_recept_activity"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:breakStrategy="simple"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:textColor="#000000"
        android:text="имя"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintStart_toEndOf="@+id/text_PFC_ccall_recept_activity"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/photo_recept_activity"
            android:layout_width="100dp"
            android:layout_height="100dp"

            tools:srcCompat="@tools:sample/avatars" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_PFC_ccall_recept_activity"
        android:layout_width="180dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:textColor="#000000"
        android:layout_marginTop="10dp"
        android:background="@drawable/edit_text_border"
        android:breakStrategy="simple"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:text="ккалл / бжу\n\n тип"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_recept_activity" />

    <TextView
        android:id="@+id/text_short_description_recept_activity"
        android:layout_width="340dp"
        android:layout_height="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/edit_text_border"
        android:breakStrategy="simple"
        android:gravity="center"
        android:textColor="#000000"
        android:paddingLeft="10dp"
        android:text="краткое описание"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_PFC_ccall_recept_activity" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_needproducts_recept"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_short_description_recept_activity" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_steps_recept"
        android:layout_width="350dp"
        android:layout_height="380dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recyclerview_needproducts_recept" />


</androidx.constraintlayout.widget.ConstraintLayout>