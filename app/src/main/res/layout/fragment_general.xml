<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.GeneralFragment"
    android:background="#FFE4B5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/profile_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/custom_user_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/PFC_summm_general"
            android:layout_width="150dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center|left"
            android:text=" БЖУ за сегодня"
            android:textColor="#000000"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ccall_summ_general" />

        <TextView
            android:id="@+id/text_view1"
            android:layout_width="wrap_content"
            android:layout_height="25dp"

            android:layout_marginTop="10dp"
            android:gravity="center|left"
            android:text="Рецепты на основе ваших предпочтений:"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/PFC_summm_general" />

        <TextView
            android:id="@+id/weight_general"
            android:layout_width="150dp"
            android:layout_height="25dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_border"
            android:drawableRight="@drawable/baseline_edit_24"
            android:gravity="center|left"
            android:text=" Вес"
            android:textColor="#000000"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@+id/ccall_summ_general"
            app:layout_constraintTop_toBottomOf="@+id/name_general" />

        <TextView
            android:id="@+id/user_name_general"
            android:layout_width="150dp"
            android:layout_height="25dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="23dp"


            android:gravity="center"
            android:text=" Вес"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@+id/ccall_summ_general"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ccall_summ_general"
            android:layout_width="150dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center|left"
            android:text=" Ккалл за сегодня"
            android:textColor="#000000"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name_general" />

        <TextView
            android:id="@+id/name_general"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_border"
            android:gravity="center|left"
            android:text=" Название"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_view1">

            <ImageView
                android:id="@+id/photo_recept_general1"
                android:layout_width="75dp"
                android:layout_height="75dp"

                tools:srcCompat="@tools:sample/avatars" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_recept_general1"
            android:layout_width="275dp"
            android:layout_height="75dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:breakStrategy="simple"
            android:gravity="center|start"
            android:paddingLeft="10dp"
            android:text="Название. Тип приема Пищи\nКкал/БЖУ\nКраткое описание "
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_view1" />

        <androidx.cardview.widget.CardView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_recept_general1">

            <ImageView
                android:id="@+id/photo_recept_general2"
                android:layout_width="75dp"
                android:layout_height="75dp"

                tools:srcCompat="@tools:sample/avatars" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_recept_general2"
            android:layout_width="275dp"
            android:layout_height="75dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:breakStrategy="simple"
            android:gravity="center|start"
            android:paddingLeft="10dp"
            android:text="Название. Тип приема Пищи\nКкал/БЖУ\nКраткое описание "
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_recept_general1" />

        <androidx.cardview.widget.CardView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_recept_general2">

            <ImageView
                android:id="@+id/photo_recept_general3"
                android:layout_width="75dp"
                android:layout_height="75dp"

                tools:srcCompat="@tools:sample/avatars" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/text_recept_general3"
            android:layout_width="275dp"
            android:layout_height="75dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/edit_text_border"
            android:breakStrategy="simple"
            android:gravity="center|start"
            android:paddingLeft="10dp"
            android:text="Название. Тип приема Пищи\nКкал/БЖУ\nКраткое описание "
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_recept_general2" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
