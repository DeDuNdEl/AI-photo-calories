<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="КБЖУ счет"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chat_BOT"
        tools:targetApi="31">
        <activity
            android:name=".Activites.ReceptActivity"
            android:exported="false" />
        <activity
            android:name=".Activites.Preferences_Or_ContraindicationsActivity"
            android:exported="false" />
        <activity
            android:name=".Activites.CounterInfoActivity"
            android:exported="false" />
        <activity
            android:name=".Activites.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".Activites.UserFieldsActivity"
            android:exported="false" />
        <activity
            android:name=".Activites.RegistrationActivity"
            android:exported="false" />
        <activity
            android:name=".Activites.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activites.MainActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
    </application>

</manifest>